<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ project }} — axis-migrate report</title>
<link rel="stylesheet" href="assets/vendor/maplibre-gl.css">
<link rel="stylesheet" href="assets/vendor/maplibre-gl-compare.css">
<style>
:root{--fg:#1f2328;--muted:#57606a;--line:#d0d7de;--bg:#fff;--soft:#f6f8fa;
--ok:#1a7f37;--ok-bg:#e6f4ea;--bad:#b42318;--bad-bg:#fde8e7;--amber:#8a5a00;--amber-bg:#fff4d6;
--purple:#6f42c1;--purple-bg:#f1e9fb;--grey:#57606a;--grey-bg:#eef0f2;--blue:#0b5cad;--blue-bg:#e5f0fb}
*{box-sizing:border-box}
body{margin:0;font:14px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--fg);background:var(--bg)}
main{max-width:1240px;margin:0 auto;padding:0 20px 40px}
h1{font-size:20px;margin:0}
h2{font-size:17px;margin:28px 0 8px;padding-top:8px;border-top:1px solid var(--line)}
h3{font-size:15px;margin:0}
code,.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12.5px}
a{color:var(--blue)}
table{border-collapse:collapse;width:100%}
th,td{border-bottom:1px solid var(--line);padding:4px 6px;text-align:left;vertical-align:top;overflow-wrap:anywhere}
.scroll{overflow-x:auto;max-width:100%}
th{background:var(--soft);font-weight:600;font-size:12.5px}
.ok{--c:var(--ok);--cb:var(--ok-bg)}.bad{--c:var(--bad);--cb:var(--bad-bg)}.amber{--c:var(--amber);--cb:var(--amber-bg)}
.purple{--c:var(--purple);--cb:var(--purple-bg)}.grey{--c:var(--grey);--cb:var(--grey-bg)}.blue{--c:var(--blue);--cb:var(--blue-bg)}
.badge{display:inline-block;border:1px solid var(--c);color:var(--c);background:var(--cb);border-radius:10px;padding:0 8px;font-size:12px;font-weight:600;white-space:nowrap}
.integrity-bar{background:var(--bad);color:#fff;padding:8px 20px;font-weight:600}
.integrity-bar.stale{background:#9a3412}
.integrity-bar a{color:#fff}
.integrity-bar ul{margin:2px 0 0;padding-left:20px;font-weight:400;font-size:13px}
#headline{padding:10px 0 0}
.hl-meta{color:var(--muted);font-size:12.5px;margin-top:2px}
.hl-row{display:flex;gap:18px;align-items:center;flex-wrap:wrap;margin:8px 0 6px}
.verdict{font-size:24px;font-weight:700;padding:4px 12px;border-radius:6px;border:2px solid var(--c);color:var(--c);background:var(--cb)}
.verdict small{font-size:14px;font-weight:600}
ol.ladder{display:flex;list-style:none;margin:0;padding:0;gap:4px;flex-wrap:wrap}
ol.ladder li{padding:3px 9px;border:1px solid var(--line);border-radius:4px;font-size:12px;color:var(--muted);background:#fff}
ol.ladder li.reached{background:var(--ok-bg);border-color:var(--ok);color:var(--ok);font-weight:600}
ol.ladder li.current{outline:2px solid var(--ok)}
ol.ladder li.greyed{border-style:dashed;color:#8c959f;background:#fafbfc}
ol.ladder li.greyed span{font-size:10.5px}
.counts{display:flex;gap:6px;flex-wrap:wrap;margin:4px 0}
.counts .badge.zero{opacity:.55}
#failures{margin:8px 0 4px;border:1px solid var(--line);border-radius:6px;padding:6px 10px;background:#fff}
#failures h2{border:0;margin:0 0 4px;padding:0;font-size:15px}
#failures ul{margin:0;padding-left:0;list-style:none}
#failures li{padding:1px 0;font-size:13.5px}
#failures .none{color:var(--ok);font-weight:600}
.caveats{font-size:12.5px;color:var(--muted);margin:4px 0}
.statusline{font-size:12px;color:var(--muted);margin:2px 0 0}
.wfgraph{max-width:100%;height:auto}
.wfgraph .node rect{fill:var(--cb);stroke:var(--c);stroke-width:2}
.wfgraph .node-id{font:600 13px system-ui,sans-serif;fill:var(--fg)}
.wfgraph .node-sub{font:12px system-ui,sans-serif;fill:var(--c)}
.wfgraph .edge{fill:none;stroke:#8c959f;stroke-width:1.5}.wfgraph .edge-head{fill:#8c959f}
.wfgraph .edge-label{font:11px ui-monospace,monospace;fill:var(--muted)}
.map-controls{display:flex;gap:16px;align-items:center;margin:4px 0 8px;flex-wrap:wrap}
#swipe-wrap{position:relative;height:500px;border:1px solid var(--line);background:#f6f6f4;overflow:hidden}
#swipe-wrap .map{position:absolute;top:0;bottom:0;width:100%}
.side-label{position:absolute;top:6px;z-index:5;background:rgba(255,255,255,.85);padding:1px 6px;font-size:12px;font-weight:600;border-radius:3px}
.legend{display:flex;gap:18px;align-items:center;font-size:12px;margin-top:6px;flex-wrap:wrap}
.ramp{display:inline-block;width:160px;height:10px;border:1px solid var(--line);vertical-align:middle}
.caption{font-size:12.5px;color:var(--muted);margin:4px 0}
#map-fallback img{max-width:100%;image-rendering:pixelated;border:1px solid var(--line)}
.card{border:1px solid var(--line);border-left:5px solid var(--c);border-radius:6px;padding:10px 12px;margin:10px 0;background:#fff}
.card-head{display:flex;gap:10px;align-items:baseline;flex-wrap:wrap}
.card .meta{color:var(--muted);font-size:12.5px}
.ds{border-top:1px dashed var(--line);margin-top:8px;padding-top:6px}
.ds-head{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}
.phr{margin:4px 0;padding-left:18px}
.phr li{margin:1px 0}
.caps li{color:var(--bad)}
.ann li{color:var(--muted)}
.missing{color:var(--bad);font-weight:600}
.plots{display:flex;gap:8px;flex-wrap:wrap;margin:6px 0}
.plots figure{margin:0;max-width:380px}
.plots img{max-width:380px;max-height:260px;border:1px solid var(--line);image-rendering:pixelated}
.plots figcaption{font-size:11.5px;color:var(--muted)}
.small{font-size:12.5px}
.notes{background:#eef0f2;border:1px solid var(--line);border-radius:6px;padding:10px}
.notes pre{white-space:pre-wrap;margin:0;font:13px/1.45 ui-monospace,monospace}
.claim{border:2px solid var(--blue);background:var(--blue-bg);padding:10px 12px;border-radius:6px;white-space:pre-wrap}
footer{color:var(--muted);font-size:12px;margin-top:24px;border-top:1px solid var(--line);padding-top:8px}
</style>
</head>
<body>
{% set p = pipeline %}
{% if integrity %}
<div id="integrity" class="integrity-bar{% if not incomplete %} stale{% endif %}" role="alert">
{% if incomplete %}EVIDENCE INCOMPLETE — {{ integrity|selectattr('severity','equalto','incomplete')|list|length }} finding(s){% else %}STALE — the project changed after run {{ run_id }}{% endif %}
<ul>
{% for x in integrity %}<li><code>{{ x.code }}</code> {{ x.detail }}{% if x.path %} · <code>{{ x.path }}</code>{% endif %}{% if x.expected %} · expected <code>{{ x.expected }}</code>{% endif %}{% if x.dataset %} · <a href="#ds-{{ x.dataset|anchor }}">{{ x.dataset }}</a>{% endif %}</li>
{% endfor %}
</ul></div>
{% endif %}
<main>
<header id="headline">
<h1>{{ project }} · axis-migrate report</h1>
<div class="hl-meta">run <code>{{ run_id }}</code> · {{ run.chain or 'chain unknown' }} · executor {{ run.executor or 'unknown' }} · isolation: {{ run.isolation or 'unknown' }} · read ledger {{ run.read_ledger or 'unknown' }} · {{ run.started_at or '' }} – {{ run.ended_at or '' }}</div>
<div class="hl-row">
{% if incomplete %}
<div class="verdict bad" id="verdict">EVIDENCE INCOMPLETE <small>— no rung</small></div>
{% elif p.headline == 'NOTHING VERIFIED' %}
<div class="verdict bad" id="verdict">NOTHING VERIFIED <small>— zero comparisons</small></div>
{% else %}
<div class="verdict {{ 'ok' if p.rung in ('reference-verified','target-ready') else ('amber' if p.rung != 'none' else 'bad') }}" id="verdict">{{ p.rung }}{% if p.suffix %} <small>{{ p.suffix }}</small>{% endif %}{% if p.rung == 'target-ready' %} <small>(not deployed)</small>{% endif %}</div>
{% endif %}
<ol class="ladder" aria-label="Status ladder">
{% for r in ladder_graphic %}<li class="{{ 'reached' if r.reached }}{{ ' current' if r.current }}">{{ r.rung }}</li>{% endfor %}
{% for g in greyed %}<li class="greyed" title="not attempted">{{ g }} <span>not attempted</span></li>{% endfor %}
</ol>
</div>
<div class="counts" aria-label="Counts by state">
{% for s, n, cls in histogram %}<span class="badge {{ cls }}{{ ' zero' if n == 0 }}">{{ s }} {{ n }}</span>{% endfor %}
</div>
<section id="failures">
<h2>Failures and open items ({{ failures|length + pipe_items|length }})</h2>
{% if failures or pipe_items %}
<ul>
{% for f in failures %}<li><span class="badge {{ f.style[0] }}">{{ f.style[1] }} {{ f.disposition }}</span> <a href="#{{ f.anchor }}"><code>{{ f.id }}</code></a> — {% if f.code %}<code>{{ f.code }}</code> {{ f.phrase }}{% else %}see card{% endif %}</li>
{% endfor %}
{% for b in pipe_items %}<li><span class="badge grey">pipeline</span> <code>{{ b.code }}</code> {{ b.phrase }}{% if b.detail %} ({{ b.detail }}){% endif %}</li>
{% endfor %}
</ul>
{% else %}<div class="none">✓ none: every in-scope step is verified</div>{% endif %}
</section>
<p class="caveats" id="caveats">{{ caveats.assumptions }} assumption(s) · {{ caveats.inferred }} inferred or fitted param(s) · {{ caveats.bridged }} bridged step(s) · {{ caveats.accepted }} accepted difference(s) · not checked: {{ caveats.not_checked }} · <strong>not deployed</strong>{% if caveats.signoff %} · <a href="../SIGN-OFF.md">migration/SIGN-OFF.md</a> (sign-off view, not evidence){% endif %}</p>
<p class="statusline"><code>{{ status_line }}</code></p>
</header>

<section id="graph">
<h2>Workflow graph</h2>
<p class="small">Nodes are coloured by step disposition and carry a text label; each links to its card. Edges name the datasets that connect the steps.</p>
{{ graph_svg|safe }}
</section>

<section id="map">
<h2>Swipe map</h2>
{% if layers %}
<div class="map-controls">
<label>Dataset <select id="layer-select">{% for l in layers %}<option value="{{ l.dataset }}"{{ ' selected' if l.dataset == default_layer }}>{{ l.dataset }} ({{ l.family }}{% if l.state %}, {{ l.state }}{% endif %})</option>{% endfor %}</select></label>
<label><input type="checkbox" id="diff-toggle"> show difference on the right (new − legacy)</label>
</div>
<div id="swipe-wrap"><div id="map-legacy" class="map"></div><div id="map-new" class="map"></div><span class="side-label" style="left:6px">legacy</span><span class="side-label" style="right:6px" id="right-label">new</span></div>
<div id="map-fallback" hidden><p class="small">WebGL is not available: static legacy | new | difference panels at full resolution.</p>{% for l in layers if l.family == 'raster' and l.files.triptych %}<img data-dataset="{{ l.dataset }}" src="assets/display/{{ l.files.triptych }}" alt="{{ l.dataset }} legacy | new | difference"{{ ' hidden' if l.dataset != default_layer }}>{% endfor %}</div>
<div class="legend" id="legend"></div>
<p class="caption" id="map-caption">{{ caption_default }}</p>
{% else %}
<p class="small">No display layers in this bundle (run <code>map.py display</code> before sealing).</p>
{% endif %}
</section>

{% macro step_card(s) %}
<article class="card {{ s.style[0] }}" id="step-{{ s.id }}">
<div class="card-head"><h3>{{ s.style[1] }} <code>{{ s.id }}</code> {{ s.title }}</h3>
<span class="badge {{ s.style[0] }}">{{ s.disposition }}</span>
<span class="meta">rung: <strong>{{ s.rung or 'n/a' }}</strong> · {{ s.kind }} · scope {{ s.scope }}{% if s.module %} · <code>{{ s.module }}</code>{% endif %}{% if s.legacy_source %} · legacy <code>{{ s.legacy_source }}</code>{% endif %}</span></div>
{% if s.caps %}<ul class="phr caps">{% for c in s.caps %}<li><code>{{ c.code }}</code> {{ c.phrase }}{% if c.detail %} ({{ c.detail }}){% endif %} → at most {{ c.max }}</li>{% endfor %}</ul>{% endif %}
{% if s.annotations %}<ul class="phr ann">{% for a in s.annotations %}<li>{{ a.text }}</li>{% endfor %}</ul>{% endif %}
{% if s.params %}<div class="meta">params: {% for pp in s.params %}<code>{{ pp.id }}</code> <span class="badge {{ 'amber' if pp.source in ('assumption','fitted') else ('blue' if pp.source == 'answer' else 'grey') }}">{{ pp.source }}</span>{{ ' ' if not loop.last }}{% endfor %}</div>{% endif %}
{% for d in s.datasets %}
<div class="ds" id="ds-{{ d.id|anchor }}">
<div class="ds-head"><strong><code>{{ d.id }}</code></strong> <span class="meta">{{ d.kind }} · {{ d.role }}</span>
{% if d.state %}<span class="badge {{ d.state_style[0] }}">{{ d.state_style[1] }} {{ d.state }}</span>{% endif %}
<span class="badge {{ d.disp_style[0] }}">{{ d.disposition }}</span>
<span class="meta">legacy <code>{{ d.legacy_path or '—' }}</code> → new <code>{{ d.new_path or '—' }}</code></span></div>
{% if d.fails or d.level_phrases %}<ul class="phr">{% for f in d.fails %}<li><code>{{ f.code }}</code> {{ f.phrase }} <span class="meta">({{ f.check }})</span></li>{% endfor %}{% for f in d.level_phrases %}<li><code>{{ f.code }}</code> {{ f.phrase }}</li>{% endfor %}</ul>{% endif %}
{% for x in d.integrity %}<div class="missing"><code>{{ x.code }}</code> {{ x.detail }}{% if x.expected %} — expected <code>{{ x.expected }}</code>{% endif %}</div>{% endfor %}
{% if d.checks %}
<table class="small"><thead><tr><th>check</th><th>state</th><th>metric</th><th>value</th><th>limit</th><th>tolerance</th><th>codes / diagnostics</th></tr></thead><tbody>
{% for c in d.checks %}<tr><td><code>{{ c.id }}</code></td><td><span class="badge {{ c.cls }}">{{ c.glyph }} {{ c.state }}</span></td><td>{{ c.metric or '' }}</td><td>{{ c.value }} {{ c.unit }}</td><td>{{ c.threshold }}</td><td>{{ c.tolerance }}</td><td>{{ c.codes|join(', ') }}{% if c.gated_by %} (gated by {{ c.gated_by }}){% endif %} {% if c.diagnostics %}<code>{{ c.diagnostics }}</code>{% endif %}{% if c.n_samples %} · {{ c.n_samples }} sample(s){% endif %}</td></tr>{% endfor %}
</tbody></table>
{% endif %}
{% if d.within_tolerance %}<div class="small">Within tolerance (all listed): {% for w in d.within_tolerance %}<code>{{ w if w is string else w|tojson }}</code>{{ '; ' if not loop.last }}{% endfor %}</div>{% endif %}
{% for k in d.kd %}<div class="small">Known difference <code>{{ k.kd }}</code>: {{ 'accepted' if k.accepted else 'not accepted' }}{% if k.why_not %} — {{ k.why_not|join('; ') }}{% endif %} · owner {{ k.owner }} · bound held: {{ 'yes' if k.bound_held else 'no' }}</div>{% endfor %}
{% if d.plots %}<div class="plots">{% for pl in d.plots %}<figure>{% if pl.ok %}<img src="{{ pl.asset }}" alt="{{ d.id }} {{ pl.name }}" loading="lazy">{% else %}<div class="missing">plot missing or changed: <code>{{ pl.path }}</code> expected <code>{{ pl.sha256 }}</code></div>{% endif %}<figcaption>{{ pl.name }} · <code>{{ pl.sha256|short }}</code></figcaption></figure>{% endfor %}</div>{% endif %}
{% if d.kind in ('raster','vector') and d.state %}
<div class="small">Visual review: {{ d.visual.receipts or 0 }} receipt(s){% if d.visual.invalid_receipts %}, {{ d.visual.invalid_receipts }} citing a plot not in this run (ignored){% endif %}{% if d.visual.flags %}, <strong>flag(s): {{ d.visual.flags|join(', ') }}</strong>{% endif %}{% if d.visual.cleared %}, cleared by a person: {{ d.visual.cleared|join(', ') }}{% endif %}.</div>
{% if d.findings %}<table class="small"><thead><tr><th>finding</th><th>question</th><th>answer</th><th>effect</th><th>category</th><th>plot</th><th>note (model-written)</th></tr></thead><tbody>
{% for f in d.findings %}<tr><td><code>{{ f.finding_id }}</code>{% if f.amended %} (amended){% endif %}</td><td>{{ f.question_id }}</td><td>{{ f.answer }}</td><td>{{ f.effect }}</td><td>{{ f.category }}</td><td><code>{{ f.plot }}</code> <code>{{ f.plot_sha256|short }}</code></td><td>{{ f.note }}</td></tr>{% endfor %}
</tbody></table>{% endif %}
{% endif %}
{% if d.compare_asset %}<div class="small"><a href="{{ d.compare_asset }}">compare result (JSON)</a></div>{% endif %}
</div>
{% endfor %}
</article>
{% endmacro %}

<section id="failed-steps">
<h2>Failed and open steps, in full ({{ failing_steps|length }})</h2>
{% for s in failing_steps %}{{ step_card(s) }}{% else %}<p class="small">None.</p>{% endfor %}
</section>

<section id="parity">
<h2>Parity table</h2>
<div class="scroll"><table class="small"><thead><tr><th>step</th><th>dataset</th><th>family</th><th>legacy path</th><th>new path</th><th>state</th><th>disposition</th><th>reason codes</th><th>key metric</th><th>tolerance</th><th>links</th></tr></thead><tbody>
{% for r in parity %}<tr><td><a href="#step-{{ r.step }}"><code>{{ r.step }}</code></a></td><td><a href="#ds-{{ r.id|anchor }}"><code>{{ r.id }}</code></a></td><td>{{ r.kind }}</td><td><code>{{ r.legacy_path or '—' }}</code></td><td><code>{{ r.new_path or '—' }}</code></td><td>{% if r.state %}<span class="badge {{ r.state_style[0] }}">{{ r.state_style[1] }} {{ r.state }}</span>{% else %}—{% endif %}</td><td><span class="badge {{ r.disp_style[0] }}">{{ r.disposition }}</span></td><td>{{ r.reason_codes|join(', ') }}</td><td>{{ r.metric }}</td><td>{% for t in r.tolerances %}<code>{{ t }}</code>{% if not loop.last %}<br>{% endif %}{% else %}exact{% endfor %}</td><td>{% if r.compare_asset %}<a href="{{ r.compare_asset }}">JSON</a>{% endif %}{% for pl in r.plots if pl.ok %} <a href="{{ pl.asset }}">{{ pl.name }}</a>{% endfor %}</td></tr>
{% endfor %}
</tbody></table></div>
</section>

<section id="passing-steps">
<h2>Verified steps ({{ passing_steps|length }})</h2>
{% for s in passing_steps %}{{ step_card(s) }}{% else %}<p class="small">None.</p>{% endfor %}
</section>

<section id="assumptions">
<h2>Assumptions and decisions</h2>
{% for g, items in param_groups %}
<h3>{{ g }} ({{ items|length }})</h3>
<table class="small"><thead><tr><th>param</th><th>step</th><th>value</th><th>source</th><th>status</th><th>reason</th><th>evidence</th></tr></thead><tbody>
{% for x in items %}<tr><td><code>{{ x.id }}</code></td><td><code>{{ x.node }}</code></td><td>{{ x.value_fmt }} {{ x.unit or '' }}</td><td>{{ x.source }}{% if x.confidence %} ({{ x.confidence }}){% endif %}{% if g == 'fitted' %} · hold-out {{ 'pass' if x.holdout_pass else 'none/fail' }}{% if x.global %} · acts globally{% endif %}{% endif %}</td><td>{{ x.status }}</td><td>{{ x.reason or '' }}</td><td>{% for e in x.evidence %}<code>{{ e }}</code> {% endfor %}</td></tr>{% endfor %}
</tbody></table>
{% if g == 'fitted' %}<p class="small">Limits of a fit: the hold-out uses the same legacy run, so a shared upstream defect is not detected; spatial autocorrelation makes the halves dependent; a parameter that acts globally makes both halves agree trivially; a fit shows the value is consistent with the legacy, not that it was intended.</p>{% endif %}
{% else %}<p class="small">No parameter records.</p>{% endfor %}
<h3>Decisions ({{ decisions|length }})</h3>
<table class="small"><thead><tr><th>id</th><th>title</th><th>kind</th><th>answer</th><th>by</th><th>params</th><th>when</th></tr></thead><tbody>
{% for d in decisions %}<tr><td><code>{{ d.id }}</code>{% if d.amended %} (after the run){% endif %}</td><td>{{ d.title }}</td><td>{{ d.kind or '' }}</td><td>{{ d.answer if d.answer is string else (d.answer|tojson) }}</td><td>{{ d.by or '' }}</td><td>{{ d.params|join(', ') }}</td><td>{{ d.timestamp or '' }}</td></tr>{% endfor %}
</tbody></table>
{% if tolerances %}<h3>Tolerance records ({{ tolerances|length }})</h3>
<table class="small"><thead><tr><th>id</th><th>dataset · check</th><th>rule</th><th>correct spread</th><th>nearest wrong</th><th>signed by</th></tr></thead><tbody>
{% for t in tolerances %}<tr><td><code>{{ t.id }}</code></td><td><code>{{ t.dataset }}</code> · {{ t.check }}</td><td>atol {{ t.atol|fmt }} · rtol {{ t.rtol|fmt }}{% if t.value is not none %} · {{ t.value|fmt }}{% endif %}</td><td>{{ t.correct_spread|fmt }}</td><td>{{ t.nearest_wrong|fmt }}</td><td>{% if t.signed %}{{ t.agreed_by }} ({{ t.agreed_at }}){% else %}<span class="missing">unsigned — ignored, check ran exact</span>{% endif %}</td></tr>{% endfor %}
</tbody></table>{% endif %}
</section>

<section id="known-differences">
<h2>Known differences ({{ kds|length }})</h2>
{% for k in kds %}
<div class="card {{ 'amber' if k.status == 'accepted' and k.human else 'grey' }}"><div class="card-head"><h3><code>{{ k.id }}</code> {{ k.title }}</h3><span class="badge {{ 'amber' if k.status == 'accepted' and k.human else 'grey' }}">{{ k.kind }} · {{ k.status }}</span></div>
<div class="small">owner: {{ k.owner or 'none' }}{% if not k.human %} (<strong>not a named human: ignored</strong>){% endif %} · datasets {{ k.datasets|join(', ') }} · bound {{ k.bound|tojson if k.bound is not none else 'none' }} · decided {{ k.decided_at or '?' }}{% if k.after_run %} · <strong>decided after seeing the difference; applies from the next run</strong>{% endif %}{% if k.unsealed %} · not in this bundle{% endif %}</div>
{% for e in k.evaluations %}<div class="small">{{ e.dataset }}: {{ 'accepted' if e.accepted else 'not accepted' }}{% if e.why_not %} — {{ e.why_not|join('; ') }}{% endif %} · bound held: {{ 'yes' if e.bound_held else 'no' }}</div>{% endfor %}
{% if k.reason %}<div class="small">reason: {{ k.reason }}</div>{% endif %}
</div>
{% else %}<p class="small">None recorded.</p>{% endfor %}
</section>

<section id="target">
<h2>Target</h2>
{% if target.state == 'not_attempted' %}<p class="small">No target bundle: target-ready not attempted.</p>
{% else %}
<p>Computed: <span class="badge {{ 'ok' if target.state == 'ready' else 'amber' }}">{{ 'target-ready' if target.state == 'ready' else 'not target-ready' }}</span> · deployment status <code>{{ target.deployment_status }}</code>{% if target.runtime %} · runtime <code>{{ target.runtime }}</code>{% endif %}</p>
{% if target.claim %}<div class="claim" id="target-claim">{{ target.claim }}</div>{% else %}<p class="missing">target-manifest.json has no claim text.</p>{% endif %}
{% if target.reasons %}<ul class="phr caps">{% for r in target.reasons %}<li><code>{{ r.code }}</code> {{ r.phrase }}{% if r.detail %} ({{ r.detail }}){% endif %}</li>{% endfor %}</ul>{% endif %}
<table class="small"><thead><tr><th>check</th><th>state</th><th>reason codes</th></tr></thead><tbody>
{% for c in target.checks %}<tr><td><code>{{ c.id }}</code></td><td>{{ c.state }}</td><td>{{ (c.reason_codes or [])|join(', ') }}</td></tr>{% endfor %}
</tbody></table>
{% if target.env_diff %}<div class="small">Environment difference: <code>{{ target.env_diff|tojson }}</code></div>{% endif %}
{% endif %}
</section>

<section id="not-checked">
<h2>Not checked</h2>
<ul class="small">
{% for r in not_checked.no_reference %}<li><code>{{ r.id }}</code>: no legacy reference ({{ r.reason_codes|join(', ') }})</li>{% endfor %}
{% for r in not_checked.not_compared %}<li><code>{{ r.id }}</code>: reference exists, not compared ({{ r.reason_codes|join(', ') }})</li>{% endfor %}
{% for r in not_checked.bridged %}<li><code>{{ r.id }}</code>: bridged (legacy artefact used; never compared against itself)</li>{% endfor %}
{% for ds, x in not_checked.compare_not_checked %}<li><code>{{ ds }}</code>: {{ x }}</li>{% endfor %}
{% for ds, q, plot in not_checked.cannot_tell %}<li><code>{{ ds }}</code>: not visually assessed ({{ q }} answered cannot_tell on <code>{{ plot }}</code>)</li>{% endfor %}
{% for f in not_checked.sweep %}<li><code>{{ f }}</code>: legacy file under an output folder that lineage never mentions</li>{% endfor %}
{% for s in not_checked.dropped %}<li><code>{{ s }}</code>: step out of scope (drop)</li>{% endfor %}
</ul>
<table class="small" style="width:auto"><thead><tr><th>state</th><th>datasets</th></tr></thead><tbody>
{% for s, n, cls in histogram %}<tr><td>{{ s }}</td><td>{{ n }}</td></tr>{% endfor %}
</tbody></table>
</section>

<section id="history">
<h2>Run history ({{ history|length }})</h2>
<table class="small"><thead><tr><th>run</th><th>chain</th><th>executor</th><th>status</th><th>exit</th><th>started</th><th>computed rung</th><th>FAIL</th><th>evidence</th></tr></thead><tbody>
{% for h in history %}<tr{% if h.current %} style="font-weight:600"{% endif %}><td><code>{{ h.run_id }}</code>{% if h.current %} (this report){% endif %}</td><td>{{ h.chain or '' }}</td><td>{{ h.executor or '' }}</td><td>{{ h.status or '' }}</td><td>{{ h.exit_code if h.exit_code is not none else '' }}</td><td>{{ h.started_at or '' }}</td><td>{{ h.rung }}{% if h.stale %} (stale){% endif %}</td><td>{{ h.fails if h.fails is not none else '—' }}</td><td>{% if h.sealed %}<a href="{{ h.link }}"><code>{{ h.evidence_id|short }}</code></a>{% if h.amendments %} +{{ h.amendments }} amendment(s){% endif %}{% else %}not sealed{% endif %}</td></tr>{% endfor %}
</tbody></table>
</section>

<section id="agent-notes">
<h2>Agent notes (model-written, not evidence)</h2>
{% if narrative %}<div class="notes"><pre>{{ narrative }}</pre></div>{% else %}<p class="small">No notes.</p>{% endif %}
</section>

<section id="reproducibility">
<h2>Reproducibility</h2>
<table class="small"><tbody>
<tr><th>run identity</th><td><code>{{ run.identity }}</code></td></tr>
<tr><th>evidence id</th><td><code>{{ evidence_id }}</code></td></tr>
{% for c in chain %}<tr><th>{{ c.file }}</th><td><code>{{ c.id }}</code>{% if c.parent %} · parent <code>{{ c.parent|short(16) }}</code> · added {{ c.added|join(', ') }}{% endif %}</td></tr>{% endfor %}
{% for k, v in sealed|dictsort %}<tr><th>sealed {{ k }}</th><td><code>{{ v or '—' }}</code></td></tr>{% endfor %}
<tr><th>environment</th><td><code>{{ envrt|tojson }}</code></td></tr>
{% for c in comparators %}<tr><th>comparator</th><td><code>{{ c[0] }} {{ c[1] }} sha256 {{ c[2] }}</code></td></tr>{% endfor %}
<tr><th>versions</th><td>report {{ versions.report }} · ladder {{ versions.ladder }} · phrases {{ versions.phrases }} · plugin {{ versions.plugin }}</td></tr>
</tbody></table>
<h3>Inputs</h3>
<table class="small"><thead><tr><th>path</th><th>size</th><th>sha256</th><th>matches inventory</th></tr></thead><tbody>
{% for o in inputs %}<tr><td><code>{{ o.path }}</code></td><td>{{ o.size|fmt }}</td><td><code>{{ o.sha256 }}</code></td><td>{{ (o.meta or {}).matches_inventory|fmt }}</td></tr>{% endfor %}
</tbody></table>
<h3>References</h3>
<table class="small"><thead><tr><th>path</th><th>dataset</th><th>sha256</th><th>kind</th><th>independence</th></tr></thead><tbody>
{% for o in refs %}<tr><td><code>{{ o.path }}</code></td><td><code>{{ o.dataset }}</code></td><td><code>{{ o.sha256 }}</code></td><td>{{ (o.meta or {}).reference_kind }}</td><td>{{ (o.meta or {}).independence }}</td></tr>{% endfor %}
</tbody></table>
<h3>Commands</h3>
<pre class="small"><code>$PLUGIN/bin/axpy $PLUGIN/skills/run/run_local.py migration --chain chained
python3 $PLUGIN/skills/report/ladder.py migration --run {{ run_id }} --json     # re-verify this bundle
$PLUGIN/bin/axpy $PLUGIN/skills/report/report.py migration --run {{ run_id }}</code></pre>
</section>
<footer>
<p>Evidence <code>{{ evidence_id }}</code> · {{ limit_note }}</p>
{% if phrase_missing %}<p><code>PHRASE_MISSING</code>: {{ phrase_missing|join(', ') }} (rendered literally)</p>{% endif %}
</footer>
</main>
{% if layers %}
<script src="assets/vendor/maplibre-gl.js"></script>
<script src="assets/vendor/maplibre-gl-compare.js"></script>
<script src="assets/layers.js"></script>
<script src="assets/swipe.js"></script>
{% endif %}
</body>
</html>
